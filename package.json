{
  "name": "after-632",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check:release": "node --import tsx scripts/check-content.ts --release",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run check:content && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
